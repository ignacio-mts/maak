# Frontend site gate (iron-session /login) — NOT Vercel Deployment Protection.
# Optional in Vercel Project → Settings → Environment Variables.
# If unset, the prototype defaults to password "loqueviene".
SITE_PASSWORD=loqueviene
# Encryption key for the session cookie — must be ≥ 32 characters.
# Optional for local/prototype; set a strong value for shared deploys.
SESSION_SECRET=
